<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiQuizChoice.ViewModels"
             xmlns:controls="clr-namespace:MauiQuizChoice.Controls"
             x:Class="MauiQuizChoice.Views.FillInQuizPage"
             x:DataType="vm:FillInQuizViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8F9FB">

    <ContentPage.BindingContext>
        <vm:FillInQuizViewModel />
    </ContentPage.BindingContext>

    <Grid>
        <!-- 1. MAIN FILL-IN QUIZ VIEW -->
        <Grid RowDefinitions="265, *, Auto">

            <!-- Curved Purple Header -->
            <Border Grid.Row="0"
                    BackgroundColor="#6B66F6"
                    StrokeThickness="0"
                    Margin="-40,-50,-40,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,180,180" />
                </Border.StrokeShape>
            </Border>

            <!-- Header Navigation + Progress + Sentence with Blank -->
            <VerticalStackLayout Grid.Row="0"
                                 Padding="24,14,24,24"
                                 Spacing="12">
                <Grid ColumnDefinitions="40, *, 40" HeightRequest="36">
                    <Border Grid.Column="0"
                            BackgroundColor="Transparent"
                            StrokeThickness="0"
                            IsVisible="{Binding CanGoBack}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PreviousCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="←"
                               TextColor="White"
                               FontSize="22"
                               HorizontalOptions="Start"
                               VerticalOptions="Center" />
                    </Border>

                    <Border Grid.Column="2"
                            BackgroundColor="Transparent"
                            StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding RestartCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="✕"
                               TextColor="White"
                               FontSize="16"
                               HorizontalOptions="End"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>

                <controls:CircularProgressView Progress="{Binding ProgressValue}"
                                               Text="{Binding ProgressText}"
                                               HorizontalOptions="Center" />

                <!-- Formatted Sentence with Inline Blank -->
                <Label HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"
                       FontSize="17">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding CurrentQuestion.PromptBeforeBlank}"
                                  TextColor="White"
                                  FontAttributes="Bold" />
                            <Span Text="  ______  "
                                  TextColor="#93C5FD"
                                  FontAttributes="Bold" />
                            <Span Text="{Binding CurrentQuestion.PromptAfterBlank}"
                                  TextColor="White"
                                  FontAttributes="Bold" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </VerticalStackLayout>

            <!-- Answer Input Card -->
            <VerticalStackLayout Grid.Row="1"
                                 Padding="24,24,24,0"
                                 Spacing="14"
                                 VerticalOptions="Start">

                <Border BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeThickness="1.5"
                        Padding="16,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsNextEnabled}" Value="True">
                            <Setter Property="Stroke" Value="#4FA8F6" />
                            <Setter Property="StrokeThickness" Value="2" />
                        </DataTrigger>
                    </Border.Triggers>

                    <Entry Text="{Binding CurrentQuestion.UserInput}"
                           Placeholder="Type your answer here..."
                           PlaceholderColor="#94A3B8"
                           TextColor="#2D3748"
                           FontSize="16"
                           ClearButtonVisibility="WhileEditing"
                           ReturnType="Next"
                           ReturnCommand="{Binding NextCommand}" />
                </Border>

                <!-- Subtle Hint Pill -->
                <Border BackgroundColor="#EEF2FF"
                        StrokeThickness="0"
                        Padding="12,8"
                        HorizontalOptions="Start">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Label Text="{Binding CurrentQuestion.Hint, StringFormat='Hint: {0}'}"
                           TextColor="#4F46E5"
                           FontSize="12"
                           FontAttributes="Bold" />
                </Border>
            </VerticalStackLayout>

            <!-- Bottom "Next" Pill Button -->
            <Button Grid.Row="2"
                    Text="Next"
                    Command="{Binding NextCommand}"
                    HeightRequest="52"
                    CornerRadius="26"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="White"
                    BackgroundColor="#D1D5DB"
                    Margin="24,10,24,36">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsNextEnabled}" Value="True">
                        <Setter Property="BackgroundColor" Value="#4FA8F6" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <!-- 2. "ANALYSING YOUR ANSWERS" OVERLAY -->
        <Grid BackgroundColor="#6B66F6"
              IsVisible="{Binding IsAnalyzing}">
            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="24">
                <Border WidthRequest="84"
                        HeightRequest="105"
                        BackgroundColor="#C7D2FE"
                        StrokeThickness="0"
                        Padding="14"
                        HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10" VerticalOptions="Center">
                        <BoxView HeightRequest="8" WidthRequest="32" CornerRadius="4" Color="White" HorizontalOptions="Start" />
                        <BoxView HeightRequest="8" WidthRequest="54" CornerRadius="4" Color="White" HorizontalOptions="Start" />
                        <BoxView HeightRequest="8" WidthRequest="44" CornerRadius="4" Color="White" HorizontalOptions="Start" />
                        <BoxView HeightRequest="8" WidthRequest="50" CornerRadius="4" Color="#818CF8" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Analysing your answers"
                       TextColor="White"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- 3. SUMMARY & SCORE SCREEN -->
        <Grid RowDefinitions="200, *, Auto"
              BackgroundColor="#F8F9FB"
              IsVisible="{Binding IsSummaryVisible}">

            <Border Grid.Row="0"
                    BackgroundColor="#6B66F6"
                    StrokeThickness="0"
                    Margin="-40,-50,-40,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,180,180" />
                </Border.StrokeShape>
            </Border>

            <VerticalStackLayout Grid.Row="0"
                                 VerticalOptions="Center"
                                 Padding="24,10,24,20"
                                 Spacing="8">
                <Border WidthRequest="44" HeightRequest="44"
                        BackgroundColor="#5752D8"
                        StrokeThickness="0"
                        HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Label Text="✓" TextColor="White" FontSize="20" FontAttributes="Bold"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Label Text="Fill-In Results"
                       TextColor="White"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />

                <Label Text="{Binding ScoreSummaryText}"
                       TextColor="#E0E7FF"
                       FontSize="14"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding ReviewResults}"
                            Margin="24,12,24,0"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FillInReviewItem">
                        <Grid Padding="0,6">
                            <Border BackgroundColor="White"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1.5"
                                    Padding="16,14">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding FullSentence}"
                                           TextColor="#2D3748"
                                           FontSize="14"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding UserAnswer, StringFormat='Your answer: {0}'}"
                                           TextColor="#6B66F6"
                                           FontSize="13" />
                                    <Label Text="{Binding CorrectAnswer, StringFormat='Expected: {0}'}"
                                           TextColor="#16A34A"
                                           FontSize="13"
                                           IsVisible="{Binding IsCorrect, Converter={StaticResource InvertedBoolConverter}}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Grid.Row="2"
                    Text="Retake Quiz"
                    Command="{Binding RestartCommand}"
                    BackgroundColor="#4FA8F6"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="52"
                    CornerRadius="26"
                    Margin="24,10,24,36" />
        </Grid>
    </Grid>
</ContentPage>