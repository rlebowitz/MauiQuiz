<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiQuizChoice.ViewModels"
             xmlns:models="clr-namespace:MauiQuizChoice.Models"
             xmlns:controls="clr-namespace:MauiQuizChoice.Controls"
             x:Class="MauiQuizChoice.Views.MatchingQuizPage"
             x:DataType="vm:MatchingQuizViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8F9FB">

    <ContentPage.BindingContext>
        <vm:MatchingQuizViewModel />
    </ContentPage.BindingContext>

    <Grid>
        <!-- 1. MAIN MATCHING QUIZ VIEW -->
        <Grid RowDefinitions="240, *, Auto">

            <!-- Curved Purple Header -->
            <Border Grid.Row="0"
                    BackgroundColor="#6B66F6"
                    StrokeThickness="0"
                    Margin="-40,-50,-40,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,180,180" />
                </Border.StrokeShape>
            </Border>

            <!-- Header Bar + Circular Progress + Instruction -->
            <VerticalStackLayout Grid.Row="0"
                                 Padding="24,16,24,24"
                                 Spacing="12">
                <Grid ColumnDefinitions="40, *, 40" HeightRequest="36">
                    <Border Grid.Column="0"
                            BackgroundColor="Transparent"
                            StrokeThickness="0"
                            IsVisible="{Binding CanGoBack}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PreviousCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="←"
                               TextColor="White"
                               FontSize="22"
                               HorizontalOptions="Start"
                               VerticalOptions="Center" />
                    </Border>

                    <Border Grid.Column="2"
                            BackgroundColor="Transparent"
                            StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding RestartCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="✕"
                               TextColor="White"
                               FontSize="16"
                               HorizontalOptions="End"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>

                <controls:CircularProgressView Progress="{Binding ProgressValue}"
                                               Text="{Binding ProgressText}"
                                               HorizontalOptions="Center" />

                <Label Text="{Binding CurrentRound.Instruction}"
                       TextColor="White"
                       FontSize="17"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <!-- Two-Column Matching Area -->
            <ScrollView Grid.Row="1" Margin="16,8,16,0">
                <Grid ColumnDefinitions="*, *" ColumnSpacing="12" VerticalOptions="Center">

                    <!-- LEFT COLUMN: Terms / Prompts -->
                    <VerticalStackLayout Grid.Column="0"
                                         BindableLayout.ItemsSource="{Binding CurrentRound.Prompts}"
                                         Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:MatchPromptItem">
                                <Border BackgroundColor="White"
                                        Stroke="#E2E8F0"
                                        StrokeThickness="1.5"
                                        Padding="14,16"
                                        MinimumHeightRequest="88">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MatchingQuizViewModel}}, Path=SelectPromptCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Border.Triggers>
                                        <!-- Highlight Blue when actively selected -->
                                        <DataTrigger TargetType="Border" Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Stroke" Value="#4FA8F6" />
                                            <Setter Property="StrokeThickness" Value="2.5" />
                                            <Setter Property="BackgroundColor" Value="#EFF6FF" />
                                        </DataTrigger>
                                        <!-- Highlight Purple when paired -->
                                        <DataTrigger TargetType="Border" Binding="{Binding IsMatched}" Value="True">
                                            <Setter Property="Stroke" Value="#6B66F6" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Grid RowDefinitions="Auto, *" RowSpacing="6">
                                        <!-- Pair Number Badge -->
                                        <Border Grid.Row="0"
                                                WidthRequest="22"
                                                HeightRequest="22"
                                                BackgroundColor="#6B66F6"
                                                StrokeThickness="0"
                                                HorizontalOptions="End"
                                                IsVisible="{Binding IsMatched}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="11" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding MatchedBadgeText}"
                                                   TextColor="White"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>

                                        <Label Grid.Row="1"
                                               Text="{Binding Text}"
                                               TextColor="#2D3748"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- RIGHT COLUMN: Definitions / Targets -->
                    <VerticalStackLayout Grid.Column="1"
                                         BindableLayout.ItemsSource="{Binding CurrentRound.Targets}"
                                         Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:MatchTargetItem">
                                <Border BackgroundColor="White"
                                        Stroke="#E2E8F0"
                                        StrokeThickness="1.5"
                                        Padding="14,16"
                                        MinimumHeightRequest="88">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MatchingQuizViewModel}}, Path=SelectTargetCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsMatched}" Value="True">
                                            <Setter Property="Stroke" Value="#6B66F6" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Grid RowDefinitions="Auto, *" RowSpacing="6">
                                        <!-- Matching Pair Number Badge -->
                                        <Border Grid.Row="0"
                                                WidthRequest="22"
                                                HeightRequest="22"
                                                BackgroundColor="#6B66F6"
                                                StrokeThickness="0"
                                                HorizontalOptions="Start"
                                                IsVisible="{Binding IsMatched}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="11" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding MatchedBadgeText}"
                                                   TextColor="White"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>

                                        <Label Grid.Row="1"
                                               Text="{Binding Text}"
                                               TextColor="#4A5568"
                                               FontSize="13"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Grid>
            </ScrollView>

            <!-- Bottom "Next" Pill Button -->
            <Button Grid.Row="2"
                    Text="Next"
                    Command="{Binding NextCommand}"
                    HeightRequest="52"
                    CornerRadius="26"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="White"
                    BackgroundColor="#D1D5DB"
                    Margin="24,10,24,32">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsNextEnabled}" Value="True">
                        <Setter Property="BackgroundColor" Value="#4FA8F6" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <!-- 2. "ANALYSING YOUR ANSWERS" OVERLAY -->
        <Grid BackgroundColor="#6B66F6"
              IsVisible="{Binding IsAnalyzing}">
            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="24">
                <Border WidthRequest="84"
                        HeightRequest="105"
                        BackgroundColor="#C7D2FE"
                        StrokeThickness="0"
                        Padding="14"
                        HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10" VerticalOptions="Center">
                        <BoxView HeightRequest="8" WidthRequest="32" CornerRadius="4" Color="White" HorizontalOptions="Start" />
                        <BoxView HeightRequest="8" WidthRequest="54" CornerRadius="4" Color="White" HorizontalOptions="Start" />
                        <BoxView HeightRequest="8" WidthRequest="44" CornerRadius="4" Color="White" HorizontalOptions="Start" />
                        <BoxView HeightRequest="8" WidthRequest="50" CornerRadius="4" Color="#818CF8" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Analysing your answers"
                       TextColor="White"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- 3. SUMMARY & SCORE SCREEN -->
        <Grid RowDefinitions="200, *, Auto"
              BackgroundColor="#F8F9FB"
              IsVisible="{Binding IsSummaryVisible}">

            <Border Grid.Row="0"
                    BackgroundColor="#6B66F6"
                    StrokeThickness="0"
                    Margin="-40,-50,-40,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,180,180" />
                </Border.StrokeShape>
            </Border>

            <VerticalStackLayout Grid.Row="0"
                                 VerticalOptions="Center"
                                 Padding="24,10,24,20"
                                 Spacing="8">
                <Border WidthRequest="44" HeightRequest="44"
                        BackgroundColor="#5752D8"
                        StrokeThickness="0"
                        HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Label Text="✓" TextColor="White" FontSize="20" FontAttributes="Bold"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Label Text="Matching Results"
                       TextColor="White"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />

                <Label Text="{Binding ScoreSummaryText}"
                       TextColor="#E0E7FF"
                       FontSize="14"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding ReviewResults}"
                            Margin="24,12,24,0"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MatchReviewItem">
                        <Grid Padding="0,6">
                            <Border BackgroundColor="White"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1.5"
                                    Padding="16,14">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Prompt}"
                                           TextColor="#2D3748"
                                           FontSize="15"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding UserMatch, StringFormat='Your match: {0}'}"
                                           TextColor="#6B66F6"
                                           FontSize="13" />
                                    <Label Text="{Binding CorrectMatch, StringFormat='Correct: {0}'}"
                                           TextColor="#16A34A"
                                           FontSize="13"
                                           IsVisible="{Binding IsCorrect, Converter={StaticResource InvertedBoolConverter}}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Grid.Row="2"
                    Text="Try Again"
                    Command="{Binding RestartCommand}"
                    BackgroundColor="#4FA8F6"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="52"
                    CornerRadius="26"
                    Margin="24,10,24,32" />
        </Grid>
    </Grid>
</ContentPage>