<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiQuizChoice.ViewModels"
             xmlns:models="clr-namespace:MauiQuizChoice.Models"
             xmlns:controls="clr-namespace:MauiQuizChoice.Controls"
             x:Class="MauiQuizChoice.Views.MultiSelectQuizPage"
             x:DataType="vm:MultiSelectQuizViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8F9FB">

    <ContentPage.BindingContext>
        <vm:MultiSelectQuizViewModel />
    </ContentPage.BindingContext>

    <Grid>
        <!-- 1. MAIN MULTI-SELECT QUIZ VIEW -->
        <Grid RowDefinitions="265, *, Auto">

            <!-- Curved Purple Header -->
            <Border Grid.Row="0"
                    BackgroundColor="#6B66F6"
                    StrokeThickness="0"
                    Margin="-40,-50,-40,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,180,180" />
                </Border.StrokeShape>
            </Border>

            <!-- Header Navigation + Progress + Hint Pill + Question -->
            <VerticalStackLayout Grid.Row="0"
                                 Padding="24,14,24,24"
                                 Spacing="10">
                <Grid ColumnDefinitions="40, *, 40" HeightRequest="36">
                    <Border Grid.Column="0"
                            BackgroundColor="Transparent"
                            StrokeThickness="0"
                            IsVisible="{Binding CanGoBack}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PreviousCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="←"
                               TextColor="White"
                               FontSize="22"
                               HorizontalOptions="Start"
                               VerticalOptions="Center" />
                    </Border>

                    <Border Grid.Column="2"
                            BackgroundColor="Transparent"
                            StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding RestartCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="✕"
                               TextColor="White"
                               FontSize="16"
                               HorizontalOptions="End"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>

                <controls:CircularProgressView Progress="{Binding ProgressValue}"
                                               Text="{Binding ProgressText}"
                                               HorizontalOptions="Center" />

                <!-- Multi-select Hint Badge -->
                <Border BackgroundColor="#5752D8"
                        StrokeThickness="0"
                        Padding="12,4"
                        HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Label Text="SELECT ALL THAT APPLY"
                           TextColor="#E0E7FF"
                           FontSize="10"
                           FontAttributes="Bold"
                           CharacterSpacing="0.8" />
                </Border>

                <Label Text="{Binding CurrentQuestion.Text}"
                       TextColor="White"
                       FontSize="17"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <!-- Multi-Select Checkbox Cards -->
            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding CurrentQuestion.Options}"
                            Margin="24,10,24,0"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:MultiSelectOption">
                        <Grid Padding="0,6">
                            <Border BackgroundColor="White"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1.5"
                                    Padding="18,16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MultiSelectQuizViewModel}}, Path=ToggleOptionCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Stroke" Value="#4FA8F6" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                        <Setter Property="BackgroundColor" Value="#F8FAFC" />
                                    </DataTrigger>
                                </Border.Triggers>

                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                    <Label Grid.Column="0"
                                           Text="{Binding Text}"
                                           TextColor="#2D3748"
                                           FontSize="15"
                                           VerticalOptions="Center" />

                                    <!-- Rounded Square Checkbox -->
                                    <Border Grid.Column="1"
                                            WidthRequest="22"
                                            HeightRequest="22"
                                            Stroke="#4A5568"
                                            StrokeThickness="1.5"
                                            BackgroundColor="Transparent">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6" />
                                        </Border.StrokeShape>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#4FA8F6" />
                                                <Setter Property="Stroke" Value="#4FA8F6" />
                                            </DataTrigger>
                                        </Border.Triggers>

                                        <Label Text="✓"
                                               TextColor="White"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding IsSelected}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Bottom "Next" Pill Button -->
            <Button Grid.Row="2"
                    Text="Next"
                    Command="{Binding NextCommand}"
                    HeightRequest="52"
                    CornerRadius="26"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="White"
                    BackgroundColor="#D1D5DB"
                    Margin="24,10,24,36">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsNextEnabled}" Value="True">
                        <Setter Property="BackgroundColor" Value="#4FA8F6" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <!-- 2. "ANALYSING YOUR ANSWERS" OVERLAY -->
        <Grid BackgroundColor="#6B66F6"
              IsVisible="{Binding IsAnalyzing}">
            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="24">
                <Border WidthRequest="84"
                        HeightRequest="105"
                        BackgroundColor="#C7D2FE"
                        StrokeThickness="0"
                        Padding="14"
                        HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10" VerticalOptions="Center">
                        <BoxView HeightRequest="8" WidthRequest="32" CornerRadius="4" Color="White" HorizontalOptions="Start" />
                        <BoxView HeightRequest="8" WidthRequest="54" CornerRadius="4" Color="White" HorizontalOptions="Start" />
                        <BoxView HeightRequest="8" WidthRequest="44" CornerRadius="4" Color="White" HorizontalOptions="Start" />
                        <BoxView HeightRequest="8" WidthRequest="50" CornerRadius="4" Color="#818CF8" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Analysing your answers"
                       TextColor="White"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- 3. SUMMARY & SCORE SCREEN -->
        <Grid RowDefinitions="200, *, Auto"
              BackgroundColor="#F8F9FB"
              IsVisible="{Binding IsSummaryVisible}">

            <Border Grid.Row="0"
                    BackgroundColor="#6B66F6"
                    StrokeThickness="0"
                    Margin="-40,-50,-40,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,180,180" />
                </Border.StrokeShape>
            </Border>

            <VerticalStackLayout Grid.Row="0"
                                 VerticalOptions="Center"
                                 Padding="24,10,24,20"
                                 Spacing="8">
                <Border WidthRequest="44" HeightRequest="44"
                        BackgroundColor="#5752D8"
                        StrokeThickness="0"
                        HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Label Text="✓" TextColor="White" FontSize="20" FontAttributes="Bold"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Label Text="Multi-Select Results"
                       TextColor="White"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />

                <Label Text="{Binding ScoreSummaryText}"
                       TextColor="#E0E7FF"
                       FontSize="14"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding ReviewResults}"
                            Margin="24,12,24,0"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MultiSelectReviewItem">
                        <Grid Padding="0,6">
                            <Border BackgroundColor="White"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1.5"
                                    Padding="16,14">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding QuestionText}"
                                           TextColor="#2D3748"
                                           FontSize="14"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding UserSelectionsText, StringFormat='Selected: {0}'}"
                                           TextColor="#6B66F6"
                                           FontSize="13" />
                                    <Label Text="{Binding CorrectSelectionsText, StringFormat='Correct set: {0}'}"
                                           TextColor="#16A34A"
                                           FontSize="13"
                                           IsVisible="{Binding IsExactMatch, Converter={StaticResource InvertedBoolConverter}}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Grid.Row="2"
                    Text="Retake Quiz"
                    Command="{Binding RestartCommand}"
                    BackgroundColor="#4FA8F6"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="52"
                    CornerRadius="26"
                    Margin="24,10,24,36" />
        </Grid>
    </Grid>
</ContentPage>